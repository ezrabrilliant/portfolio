# Headers for the static files the Worker serves (wrangler.jsonc assets); /api/* answers come from worker/index.js.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer-when-downgrade

# Aset Vite di /assets memakai hash pada nama file, jadi aman di-cache lama.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
