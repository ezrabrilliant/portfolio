// The site on Cloudflare Workers: `npm run deploy` builds dist/ and deploys it as the Worker's static assets, with
// worker/index.js answering /api/* (the GTID proxy that server.js used to run). Name and compatibility date match the
// Worker that already serves beta.ezrabrilliant.com (its custom domain is set on the Worker, not here).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-beta",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // client-side routes fall back to index.html, as on the old server
    "not_found_handling": "single-page-application",
    // /api/* reaches the script even though the SPA fallback would otherwise answer it with the page
    "run_worker_first": ["/api/*"]
  }
}
